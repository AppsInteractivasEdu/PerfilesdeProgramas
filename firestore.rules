rules_version = '2';

// Reglas de seguridad para el aplicativo de Perfiles Docentes.
// Modelo: usuarios/{uid} define el rol y, según el rol, el programa o
// departamento al que pertenece:
//   - director:     programaId      (ve y revisa solo las asignaturas de su programa)
//   - departamento: departamentoId  (ve y revisa solo las asignaturas asignadas a su departamento,
//                                    que pueden ser de varios programas)
//   - decano:        ninguno        (ve y revisa TODAS las asignaturas)
//   - viceacademico: ninguno        (ve TODAS las asignaturas, solo lectura: nunca puede escribir)
//   - admin:         ninguno        ("Director de Departamento": ve y resuelve todo)
//
// asignaturas/{id} guarda el contenido y, dentro de cada uno de sus
// componentes, una revisión independiente por cada revisor aplicable
// (componentes.<clave>.revisiones.director / .departamento / .decano),
// cada una con su propio estado y la resolución del admin.
//
// Estas reglas son una base razonable para un número pequeño de usuarios
// conocidos. No se sometieron a una auditoría de seguridad independiente —
// pruébalas en el "Rules Playground" de Firebase Console antes de
// considerarlas definitivas.

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esAdmin() {
      return autenticado() && perfil().rol == 'admin';
    }

    function esDecano() {
      return autenticado() && perfil().rol == 'decano';
    }

    // Observador puro (p. ej. Vicerrectoría Académica): ve todo lo mismo que
    // el decano, pero nunca puede escribir — por eso NO aparece en ninguna
    // regla "allow update/write" de este archivo, solo en las de "read".
    function esViceacademico() {
      return autenticado() && perfil().rol == 'viceacademico';
    }

    function esDirectorDelPrograma(programaId) {
      return autenticado()
        && perfil().rol == 'director'
        && perfil().programaId == programaId;
    }

    function esDepartamentoDe(departamentoId) {
      return autenticado()
        && perfil().rol == 'departamento'
        && departamentoId != null
        && perfil().departamentoId == departamentoId;
    }

    // usuarios: cada quien lee solo su propio perfil; el admin y el decano pueden leer todos
    // (el decano necesita saber quién es director de cada programa para los filtros;
    // el admin, además, para mostrar la última sesión de cada uno).
    // Los usuarios se crean con el script de carga (scripts/seed.cjs) usando
    // el SDK de administrador. La única escritura permitida desde el cliente
    // es que cada quien marque su propia "ultimaConexion" al entrar —
    // ningún otro campo (rol, programa, departamento) se puede tocar así.
    match /usuarios/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || esAdmin() || esDecano());
      allow update: if autenticado() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimaConexion']);
      allow create, delete: if false;
    }

    // programas y departamentos: catálogos de solo lectura para cualquier usuario autenticado.
    match /programas/{programaId} {
      allow read: if autenticado();
      allow write: if false;
    }
    match /departamentos/{departamentoId} {
      allow read: if autenticado();
      allow write: if false;
    }

    // asignaturas: el director ve y actualiza solo las de su programa; el
    // departamento solo las que tiene asignadas; el decano y el admin, todas.
    match /asignaturas/{asignaturaId} {
      allow read: if esAdmin() || esDecano() || esViceacademico()
        || esDirectorDelPrograma(resource.data.programaId)
        || esDepartamentoDe(resource.data.departamentoId);

      // Solo se permite tocar el mapa "componentes" (estado/comentario de
      // cada revisión), nunca el contenido original, el programa o el
      // departamento al que pertenece la fila.
      allow update: if (
        esAdmin() || esDecano()
        || esDirectorDelPrograma(resource.data.programaId)
        || esDepartamentoDe(resource.data.departamentoId)
      )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['componentes'])
        && request.resource.data.nombre == resource.data.nombre
        && request.resource.data.programaId == resource.data.programaId
        && request.resource.data.departamentoId == resource.data.departamentoId;

      allow create, delete: if false; // la carga inicial se hace con el script de administrador
    }

    // perfilesPublicos: espejo de SOLO el texto final de cada asignatura
    // (sin comentarios de revisión ni estados internos), de lectura pública
    // y sin autenticación. Lo usa el micrositio externo para armar sus
    // propios filtros, en vez de que alguien suba a mano el PDF que antes
    // se descargaba desde este aplicativo. El Director de Departamento
    // (admin) es el único que puede escribir aquí, y solo lo hace desde
    // editarTextoComponente (src/services/asignaturas.js) o desde el
    // script de respaldo inicial (scripts/exportar_perfiles_publicos.cjs,
    // que usa el SDK de administrador y no pasa por estas reglas).
    match /perfilesPublicos/{asignaturaId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ofertas2027I: asignaturas sobre las que cada director de programa define cuántos grupos se
    // ofertarán en 2027-I (grupos: null = sin definir, 0 = SIN OFERTAR, 1..10). Cada director solo
    // puede ver y modificar las filas de SU programa; el Director de Departamento (admin) y la
    // Vicerrectoría Académica (viceacademico) ven todas — solo lectura para esta última. También lo
    // usa el aplicativo de Asignación Docente iniciando sesión con la cuenta del admin. Las filas las
    // crea el script scripts/seed_oferta.cjs (SDK de administrador); desde el navegador solo se
    // puede cambiar `grupos` (y quién/cuándo), y únicamente el admin y los directores.
    match /ofertas2027I/{ofertaId} {
      allow read: if esAdmin() || esViceacademico() || esDirectorDelPrograma(resource.data.programaId);
      allow update: if (esAdmin() || esDirectorDelPrograma(resource.data.programaId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['grupos', 'actualizadoPor', 'actualizadoEn'])
        && (request.resource.data.grupos == null
            || (request.resource.data.grupos is int
                && request.resource.data.grupos >= 0
                && request.resource.data.grupos <= 10));
      allow create, delete: if false;
    }
  }
}
